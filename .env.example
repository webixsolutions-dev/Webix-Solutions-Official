# -----------------------------------------------------------------------------
# Webix Solutions — Environment Variables Example
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development or set in Cloudflare Workers / production hosting.
# NEVER commit real secret keys into version control.

# Google Calendar OAuth Credentials (for live booking & Google Meet creation)
# Follow step-by-step setup in docs/BOOKING-SETUP.md
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_CALENDAR_ID=primary

# Cloudflare Turnstile (Bot protection on booking & contact forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Webix Ops Internal CRM Webhook (Optional notification dispatch)
CRM_WEBHOOK_URL=https://webhook.webixsolutions.com/api/bookings

# Analytics & Tracking (Consent-gated via Cookie Banner)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=0000000000000000
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Resend Email API (Optional branded confirmation emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
